<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.controller.SignupController"
            prefWidth="400"
            prefHeight="550"
            style="-fx-background-color: #f4f6f8;">

    <VBox alignment="CENTER"
          spacing="15"
          AnchorPane.topAnchor="40"
          AnchorPane.leftAnchor="50"
          AnchorPane.rightAnchor="50">

        <padding>
            <Insets top="30" right="30" bottom="30" left="30"/>
        </padding>

        <Label text="Create Account"
               style="-fx-font-size: 26px; -fx-font-weight: bold;"/>

        <Label text="Sign up to get started"
               style="-fx-text-fill: #666666;"/>

        <TextField fx:id="fullNameField"
                   promptText="Full Name"
                   prefHeight="40"/>

        <TextField fx:id="emailField"
                   promptText="Email"
                   prefHeight="40"/>

        <TextField fx:id="usernameField"
                   promptText="Username"
                   prefHeight="40"/>

        <PasswordField fx:id="passwordField"
                       promptText="Password"
                       prefHeight="40"/>

        <PasswordField fx:id="confirmPasswordField"
                       promptText="Confirm Password"
                       prefHeight="40"/>

        <Button fx:id="signupButton"
                text="Sign Up"
                prefWidth="250"
                prefHeight="40"
                onAction="#handleSignup"
                style="-fx-background-color: #16a34a; -fx-text-fill: white; -fx-font-weight: bold;"/>

        <Hyperlink text="Already have an account? Login"
                   onAction="#handleGoToLogin"/>

        <Label fx:id="messageLabel"
               text=""
               style="-fx-text-fill: red;"/>

    </VBox>

</AnchorPane>