<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.controller.LoginController"
            prefWidth="400"
            prefHeight="500"
            style="-fx-background-color: #f4f6f8;">

    <VBox alignment="CENTER"
          spacing="15"
          AnchorPane.topAnchor="60"
          AnchorPane.leftAnchor="50"
          AnchorPane.rightAnchor="50">

        <padding>
            <Insets top="30" right="30" bottom="30" left="30"/>
        </padding>

        <Label text="Login"
               style="-fx-font-size: 28px; -fx-font-weight: bold;"/>

        <Label text="Welcome back! Please sign in."
               style="-fx-text-fill: #666666;"/>

        <TextField fx:id="usernameField"
                   promptText="Username or Email"
                   prefHeight="40"/>

        <PasswordField fx:id="passwordField"
                       promptText="Password"
                       prefHeight="40"/>

        <Button fx:id="loginButton"
                text="Login"
                prefWidth="250"
                prefHeight="40"
                onAction="#handleLogin"
                style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold;"/>

        <Hyperlink text="Forgot password?"
                   onAction="#handleForgotPassword"/>

        <Label fx:id="messageLabel"
               text=""
               style="-fx-text-fill: red;"/>

    </VBox>

</AnchorPane>