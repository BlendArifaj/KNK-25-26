<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="520" prefWidth="500" style="-fx-background-color: #f4f6f8;" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ResetPasswordController">

    <VBox alignment="CENTER" spacing="18" AnchorPane.bottomAnchor="40" AnchorPane.leftAnchor="60" AnchorPane.rightAnchor="60" AnchorPane.topAnchor="40">

        <Label style="-fx-text-fill: #2c3e50;" text="Reset Password">
            <font>
                <Font size="28" />
            </font>
        </Label>

        <Label style="-fx-text-fill: #6c757d;" text="Enter your security PIN to verify your identity." textAlignment="CENTER" wrapText="true" />

        <VBox spacing="12" style="-fx-background-color: white;                      -fx-background-radius: 12;                      -fx-padding: 28;                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 12, 0, 0, 4);">

            <Label text="Username" />
            <TextField fx:id="usernameField" prefHeight="38" promptText="Enter username" />

            <Label text="Security PIN" />
            <PasswordField fx:id="securityPinField" prefHeight="38" promptText="Enter your security PIN" />

            <Label text="New Password" />
            <PasswordField fx:id="newPasswordField" prefHeight="38" promptText="Enter new password" />

            <Label text="Confirm Password" />
            <PasswordField fx:id="confirmPasswordField" prefHeight="38" promptText="Confirm new password" />

            <Label fx:id="messageLabel" style="-fx-text-fill: red;" wrapText="true" />

            <Button fx:id="resetPasswordButton" maxWidth="Infinity" onAction="#handleResetPassword" prefHeight="42" style="-fx-background-color: #2563eb;                            -fx-text-fill: white;                            -fx-font-size: 14;                            -fx-background-radius: 8;                            -fx-cursor: hand;" text="Reset Password" />

            <Hyperlink fx:id="backToLoginLink" maxWidth="Infinity" onAction="#handleBackToLogin" text="Back to Login" />
        </VBox>
    </VBox>
</AnchorPane>
