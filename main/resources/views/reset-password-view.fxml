<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.controller.ResetPasswordController"
            prefWidth="500"
            prefHeight="520"
            style="-fx-background-color: #f4f6f8;">

    <VBox alignment="CENTER"
          spacing="18"
          AnchorPane.topAnchor="40"
          AnchorPane.bottomAnchor="40"
          AnchorPane.leftAnchor="60"
          AnchorPane.rightAnchor="60">

        <Label text="Reset Password"
               style="-fx-text-fill: #2c3e50;">
            <font>
                <Font size="28"/>
            </font>
        </Label>

        <Label text="Enter your security PIN to verify your identity."
               wrapText="true"
               textAlignment="CENTER"
               style="-fx-text-fill: #6c757d;"/>

        <VBox spacing="12"
              style="-fx-background-color: white;
                     -fx-background-radius: 12;
                     -fx-padding: 28;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 12, 0, 0, 4);">

            <Label text="Username or Email"/>
            <TextField fx:id="usernameOrEmailField"
                       promptText="Enter username or email"
                       prefHeight="38"/>

            <Label text="Security PIN"/>
            <PasswordField fx:id="securityPinField"
                           promptText="Enter your security PIN"
                           prefHeight="38"/>

            <Label text="New Password"/>
            <PasswordField fx:id="newPasswordField"
                           promptText="Enter new password"
                           prefHeight="38"/>

            <Label text="Confirm Password"/>
            <PasswordField fx:id="confirmPasswordField"
                           promptText="Confirm new password"
                           prefHeight="38"/>

            <Label fx:id="messageLabel"
                   text=""
                   wrapText="true"
                   style="-fx-text-fill: red;"/>

            <Button fx:id="resetPasswordButton"
                    text="Reset Password"
                    onAction="#handleResetPassword"
                    prefHeight="42"
                    maxWidth="Infinity"
                    style="-fx-background-color: #2563eb;
                           -fx-text-fill: white;
                           -fx-font-size: 14;
                           -fx-background-radius: 8;
                           -fx-cursor: hand;"/>

            <Hyperlink fx:id="backToLoginLink"
                       text="Back to Login"
                       onAction="#handleBackToLogin"
                       maxWidth="Infinity"/>
        </VBox>
    </VBox>
</AnchorPane>