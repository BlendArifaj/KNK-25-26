<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.LoginController"
            prefWidth="400"
            prefHeight="500"
            style="-fx-background-color: #f4f6f8;">

    <VBox spacing="18"
          alignment="CENTER"
          AnchorPane.topAnchor="60"
          AnchorPane.leftAnchor="50"
          AnchorPane.rightAnchor="50">

        <padding>
            <Insets top="30" right="25" bottom="30" left="25"/>
        </padding>

        <Label text="Login"
               style="-fx-font-size: 32px; -fx-font-weight: bold;"/>

        <Label text="Welcome back! Please sign in."
               style="-fx-text-fill: #666; -fx-font-size: 14px;"/>

        <TextField fx:id="usernameField"
                   promptText="Username or email"
                   prefHeight="40"/>

        <PasswordField fx:id="passwordField"
                       promptText="Password"
                       prefHeight="40"/>

        <Button fx:id="loginButton"
                text="Login"
                onAction="#handleLogin"
                prefWidth="300"
                prefHeight="42"
                style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-background-radius: 6;"/>

        <Hyperlink text="Forgot password?"
                   onAction="#handleForgotPassword"/>

        <Label fx:id="messageLabel"
               text=""
               style="-fx-text-fill: red;"/>

    </VBox>

</AnchorPane>