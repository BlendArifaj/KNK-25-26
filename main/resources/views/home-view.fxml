<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="650" prefWidth="1000" style="-fx-background-color: #f4f8fb;" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.HomeController">

    <!-- Top Navbar -->
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="70" spacing="20" style="-fx-background-color: #1976d2;">
            <padding>
                <Insets bottom="0" left="30" right="30" top="0" />
            </padding>

            <Label text="%app.title" textFill="white">
                <font>
                    <Font size="24" />
                </font>
            </Label>

            <Region HBox.hgrow="ALWAYS" />

            <Button style="-fx-background-color: white; -fx-text-fill: #1976d2;" text="%nav.home" />
            <Button style="-fx-background-color: transparent; -fx-text-fill: white;" text="%nav.doctors" />
            <Button style="-fx-background-color: transparent; -fx-text-fill: white;" text="%nav.appointments" />
            <Button style="-fx-background-color: white; -fx-text-fill: #1976d2;" text="%nav.login" />
        </HBox>
    </top>

    <!-- Main Content -->
    <center>
        <VBox fx:id="contentPane" alignment="TOP_CENTER" spacing="30">
            <padding>
                <Insets bottom="50" left="50" right="50" top="50" />
            </padding>

            <!-- Hero Section -->
            <VBox alignment="CENTER" spacing="15">
                <Label text="%hero.title">
                    <font>
                        <Font size="34" />
                    </font>
                </Label>

                <Label style="-fx-text-fill: #555555;" text="%hero.subtitle">
                    <font>
                        <Font size="16" />
                    </font>
                </Label>

                <Button fx:id="bookAppointmentButton" onAction="#handleBtnClick" prefHeight="45" prefWidth="200" style="-fx-background-color: #1976d2; -fx-text-fill: white; -fx-background-radius: 8;" text="%hero.bookButton">
                    <font>
                        <Font size="15" />
                    </font>
                </Button>
            </VBox>

            <!-- Cards Section -->
            <HBox alignment="CENTER" spacing="25">

                <VBox alignment="CENTER" prefHeight="160" prefWidth="250" spacing="12" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 8, 0, 0, 3);">
                    <Label text="👨‍⚕️">
                        <font>
                            <Font size="36" />
                        </font>
                    </Label>
                    <Label text="%card.findDoctors.title">
                        <font>
                            <Font size="20" />
                        </font>
                    </Label>
                    <Label style="-fx-text-fill: #666666;" text="%card.findDoctors.desc" />
                </VBox>

                <VBox alignment="CENTER" prefHeight="160" prefWidth="250" spacing="12" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 8, 0, 0, 3);">
                    <Label text="📅">
                        <font>
                            <Font size="36" />
                        </font>
                    </Label>
                    <Label text="%card.easyBooking.title">
                        <font>
                            <Font size="20" />
                        </font>
                    </Label>
                    <Label style="-fx-text-fill: #666666;" text="%card.easyBooking.desc" />
                </VBox>

                <VBox alignment="CENTER" prefHeight="160" prefWidth="250" spacing="12" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 8, 0, 0, 3);">
                    <Label text="✅">
                        <font>
                            <Font size="36" />
                        </font>
                    </Label>
                    <Label text="%card.manageVisits.title">
                        <font>
                            <Font size="20" />
                        </font>
                    </Label>
                    <Label style="-fx-text-fill: #666666;" text="%card.manageVisits.desc" />
                </VBox>

            </HBox>

            <!-- Search Box -->
            <VBox alignment="CENTER" prefWidth="700" spacing="15" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 8, 0, 0, 3);">

                <Label text="%search.title">
                    <font>
                        <Font size="22" />
                    </font>
                </Label>

                <HBox alignment="CENTER" spacing="12">
                    <TextField fx:id="searchDoctorField" prefHeight="40" prefWidth="350" promptText="%search.placeholder" />

                    <ComboBox fx:id="specialtyComboBox" prefHeight="40" prefWidth="180" promptText="%search.specialty" />

                    <Button fx:id="searchButton" prefHeight="40" prefWidth="100" style="-fx-background-color: #1976d2; -fx-text-fill: white; -fx-background-radius: 6;" text="%search.button" />
                </HBox>
            </VBox>

        </VBox>
    </center>

    <!-- Footer -->
    <bottom>
        <HBox alignment="CENTER" prefHeight="45" style="-fx-background-color: #e3f2fd;">
            <Label style="-fx-text-fill: #555555;" text="%footer.text" />
        </HBox>
    </bottom>

</BorderPane>